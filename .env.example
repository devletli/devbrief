OPENROUTER_API_KEY=
# Virgülle ayrılmış, sırayla denenir. Güncel :free modelleri openrouter.ai/models?q=free adresinden seç.
LLM_MODELS_FAST=
LLM_MODELS_SMART=
LLM_DAILY_BUDGET=400
LLM_RATE_PER_MINUTE=15
# Gorev cikti sinirlari (token); length kesintisinde ayni model 2x ile 1 kez dener.
LLM_MAX_TOKENS_CLASSIFY=4096
LLM_MAX_TOKENS_SELECT=2048
LLM_MAX_TOKENS_WRITE_SCRIPT=4096
LLM_MAX_TOKENS_VERIFY=2048
LLM_MAX_TOKENS_WRITE_METADATA=4096
LLM_MAX_TOKENS_REPAIR=4096
LLM_MAX_TOKENS_CAP=8000
# Akil yurutme: off (kapat) | low (dusuk efor) | default (karisma).
LLM_REASONING=default
# Probe listesi (bos ise FAST+SMART+VERIFY).
LLM_PROBE_MODELS=
# Prefilter katsayilari (docs/02 §6); `prefilter --show` ile ayarlanir.
PREFILTER_W_SOURCE=1.0
PREFILTER_W_POP=0.5
PREFILTER_W_FRESH=1.0
PREFILTER_W_KW=1.0
PREFILTER_PER_SOURCE_CAP=10
PREFILTER_TOTAL=40
PREFILTER_TERMS=config/prefilter_terms.yaml
DEDUPE_JACCARD=0.5
DEDUPE_DIFFLIB=0.8
ONSCREEN_REPEAT_THR=0.8
EVAL_TR_RATIO=0.05
EVIDENCE_TOKEN_COVERAGE=0.85
EVIDENCE_DIFFLIB=0.9
LLM_TIMEOUT_FAST_S=60
LLM_TIMEOUT_SMART_S=180
# Ucretli model korumasi: kapali iken ":free" bitmeyen model reddedilir.
ALLOW_PAID_MODELS=false
PAID_MODELS_ALLOWLIST=
# Dogrulayici modelleri (bos ise SMART kullanilir).
LLM_MODELS_VERIFY=
# Yayin modu: shadow (hicbir sey cikmaz) | private (yalnizca ozel YT) | live.
PUBLISH_MODE=shadow
# live icin ikinci onay sarti (yoksa sessizce private'a duser).
LIVE_CONFIRM=
GITHUB_TOKEN=
YOUTUBE_CLIENT_SECRETS=./secrets/client_secret.json
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TTS_VOICE=tr-TR-AhmetNeural
# Windows konsol Turkcesi icin (cli.py de reconfigure yapar).
PYTHONUTF8=1
# ffmpeg/ffprobe: bos ise PATH, sonra repo ici bin/ kullanilir.
FFMPEG_PATH=
FFPROBE_PATH=

# --- API / n8n ---
DEVBRIEF_API_TOKEN=
N8N_CALLBACK_URL=http://n8n:5678/webhook/devbrief-run-finished
N8N_CALLBACK_SECRET=
N8N_ENCRYPTION_KEY=
N8N_WEBHOOK_URL=http://localhost:5678/
# Yayın merkezi (Postiz/Upload-Post/Ayrshare vb.) n8n credential'ında tutulur
